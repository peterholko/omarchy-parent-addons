#!/bin/bash
# omarchy:summary=Manage private browsing reports with the parent password
# omarchy:args=<ui|status|on|off|pages|videos> [DAYS] [--user NAME]
# omarchy:requires-sudo=true
set -euo pipefail
if [[ ${1:-} == "ui" ]]; then
  if (( $# != 1 )); then
    echo "Usage: omarchy parent browsing ui" >&2
    exit 2
  fi
  if (( EUID == 0 )); then
    echo "Open the History panel as the desktop user, without sudo." >&2
    exit 1
  fi
  result=$(omarchy-shell shell summon io.github.peterholko.parent-browsing)
  if [[ $result != "ok" ]]; then
    echo "The History panel is unavailable. Install its plugin, then run: omarchy plugin enable io.github.peterholko.parent-browsing" >&2
    exit 1
  fi
elif [[ ${1:-} == "--help" || ${1:-} == "-h" ]] || (( EUID == 0 )); then
  exec /usr/lib/omarchy-parent-addons/control browsing "$@"
else
  exec /usr/bin/sudo -k -- /usr/lib/omarchy-parent-addons/control browsing "$@"
fi
